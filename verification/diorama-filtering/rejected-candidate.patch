+/** Original CanvasTexture minifies with mipmaps; the simple drawImage overload
+ * uses only bilinear sampling. Keep the shaped texture and filter on the GPU. */
+internal fun DrawScope.drawDioramaTexture(image: ImageBitmap, alpha: Float = 1f,
+    color: Color? = null, additive: Boolean = false) {
+    drawImage(image, alpha=alpha, colorFilter=color?.let { ColorFilter.tint(it) },
+        blendMode=if(additive)BlendMode.Plus else BlendMode.SrcOver,
+        filterQuality=FilterQuality.Medium)
+}
