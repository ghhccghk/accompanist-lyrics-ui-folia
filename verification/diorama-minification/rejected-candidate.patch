+
+@OptIn(ExperimentalTestApi::class)
+class DioramaMipPyramidTest {
+    @Test fun boundedHalvingRetainsBaseAndDoesNotMutatePixels()=runDesktopComposeUiTest(width=160,height=120) {
+        val base=ImageBitmap(65,17)
+        CanvasDrawScope().draw(Density(1f),LayoutDirection.Ltr,Canvas(base),Size(65f,17f)) {
+            drawRect(Color.White,Offset(5f,4f),Size(47f,9f))
+        }
+        fun pixels(image:ImageBitmap)=IntArray(image.width*image.height).also{image.readPixels(it)}
+        val original=pixels(base);val pyramid=DioramaMipPyramid.prepare(base)
+        assertSame(base,pyramid.levels.first());assertContentEquals(original,pixels(base))
+        assertEquals(listOf(65 to 17,32 to 8,16 to 4,8 to 2,4 to 1,2 to 1,1 to 1),pyramid.levels.map{it.width to it.height})
+        assertTrue(pyramid.levels.sumOf{it.width.toLong()*it.height}<2L*base.width*base.height)
+    }
+
+    @Test fun magnificationKeepsBasePathExactlyAndMinificationRetainsParentAlpha()=runDesktopComposeUiTest(width=160,height=120) {
+        val image=ImageBitmap(64,64)
+        CanvasDrawScope().draw(Density(1f),LayoutDirection.Ltr,Canvas(image),Size(64f,64f)){drawRect(Color.White)}
+        val pyramid=DioramaMipPyramid.prepare(image)
+        val identities=pyramid.levels.toList()
+        val view=DioramaPerspective(DioramaVec(0.0,0.0,5.0),DioramaVec(0.0,0.0,0.0),160.0,120.0)
+        var minified by mutableStateOf(false);var mip by mutableStateOf(false)
+        setContent {
+            Canvas(Modifier.fillMaxSize().background(Color.Black)) {
+                val scale=if(minified).015 else .12
+                val x=DioramaVec(scale,0.0,0.0);val y=DioramaVec(0.0,-scale,0.0)
+                val origin=DioramaVec(-32*scale,32*scale,0.0)
+                // Simulate an ancestor transition alpha through the same
+                // Compose Canvas path; applying it twice would fail the center.
+                drawContext.canvas.saveLayer(Rect(0f,0f,160f,120f),Paint().apply{alpha=.4f})
+                try {
+                    if(mip)pyramid.draw(this,view,origin,x,y,1f,Color.White,null)
+                    else drawDioramaPlane(image,view,origin,x,y,1f,Color.White)
+                }finally{drawContext.canvas.restore()}
+            }
+        }
+        fun pixels():IntArray{waitForIdle();val im=captureToImage();return IntArray(im.width*im.height).also{im.readPixels(it)}}
+        val base=pixels();runOnIdle{mip=true};assertContentEquals(base,pixels(),"magnified path must be byte-identical")
+        runOnIdle{minified=true};val minifiedImage=pixels()
+        val center=Color(minifiedImage[60*160+80])
+        assertEquals(.4f,center.red,2f/255);assertEquals(center.red,center.green,0f);assertEquals(center.red,center.blue,0f)
+        assertTrue(pyramid.levelAt(view,DioramaVec(-.48,.48,0.0),DioramaVec(.015,0.0,0.0),DioramaVec(0.0,-.015,0.0)) in 1.0..2.0)
+        mainClock.advanceTimeBy(1000);assertContentEquals(minifiedImage,pixels(),"no autonomous mip clock")
+        identities.zip(pyramid.levels).forEach{(a,b)->assertSame(a,b)}
+    }
+}
