+// SPDX-License-Identifier: AGPL-3.0-only
+// Independent minification adapter for Folia's cached neighbour text planes.
+// Isotropic approximation, not WebGL anisotropic sampling equivalence.
+package top.ghhccghk.accompanist.lyrics.folia.internal.styles.diorama
+
+import androidx.compose.ui.geometry.*
+import androidx.compose.ui.graphics.*
+import androidx.compose.ui.graphics.drawscope.*
+import androidx.compose.ui.unit.*
+import kotlin.math.*
+
+/** Immutable and owned by ONE prepared paragraph; no global cache or per-frame
+ * image preparation. Extra pixel storage is bounded by the halving chain.
+ * Base level remains the original fully shaped paragraph. */
+internal class DioramaMipPyramid private constructor(val levels:List<ImageBitmap>) {
+    fun levelAt(view:DioramaPerspective,origin:DioramaVec,x:DioramaVec,y:DioramaVec):Double {
+        val base=levels.first()
+        return dioramaMipLevel(view.planeHomography(origin,x,y),base.width.toDouble(),base.height.toDouble(),levels.lastIndex)
+    }
+
+    fun draw(scope:DrawScope,view:DioramaPerspective,origin:DioramaVec,x:DioramaVec,y:DioramaVec,
+        alpha:Float,color:Color,fog:DioramaFog?) {
+        if(alpha<=0)return
+        val lod=levelAt(view,origin,x,y)
+        val base=levels.first()
+        if(lod<=0) {
+            scope.drawDioramaPlane(base,view,origin,x,y,alpha,color,fog=fog)
+            return
+        }
+        val low=floor(lod).toInt();val high=min(low+1,levels.lastIndex);val weight=(lod-low).toFloat()
+        // Weighted premultiplied contributions must add in a transparent layer;
+        // two SrcOver draws would darken/attenuate the second mip incorrectly.
+        val canvas=scope.drawContext.canvas
+        canvas.saveLayer(Rect(0f,0f,view.width.toFloat(),view.height.toFloat()),Paint())
+        try {
+            fun draw(index:Int,fraction:Float) {
+                if(fraction<=0)return
+                val image=levels[index]
+                scope.drawDioramaPlane(image,view,origin,x*(base.width.toDouble()/image.width),
+                    y*(base.height.toDouble()/image.height),alpha*fraction,color,additive=true,fog=fog)
+            }
+            draw(low,1f-weight);draw(high,weight)
+        }finally{canvas.restore()}
+    }
+
+    companion object {
+        fun prepare(image:ImageBitmap):DioramaMipPyramid {
+            val levels=buildList {
+                add(image)
+                while(last().width>1 || last().height>1) {
+                    val previous=last();val width=max(1,previous.width/2);val height=max(1,previous.height/2)
+                    val next=ImageBitmap(width,height)
+                    CanvasDrawScope().draw(Density(1f),LayoutDirection.Ltr,Canvas(next),Size(width.toFloat(),height.toFloat())) {
+                        drawImage(previous,dstSize=IntSize(width,height),filterQuality=FilterQuality.Low)
+                    }
+                    add(next)
+                }
+            }
+            return DioramaMipPyramid(levels)
+        }
+    }
+}
+
+/** Inverse screen Jacobian gives the source-texel footprint of a screen pixel.
+ * Use the larger of its two column lengths, matching isotropic derivative LOD;
+ * no frame/viewport constant, fitted offset or hand-selected level. The plane
+ * center is an explicit bounded approximation, NOT per-fragment anisotropy4.
+ * Degenerate/behind-center planes retain the clipped base path. */
+internal fun dioramaMipLevel(h:List<Double>,width:Double,height:Double,lastLevel:Int):Double {
+    val u=width/2;val v=height/2
+    val a=h[0]*u+h[1]*v+h[2];val b=h[3]*u+h[4]*v+h[5];val z=h[6]*u+h[7]*v+h[8]
+    if(z<=0 || !z.isFinite())return 0.0
+    val xx=(h[0]*z-a*h[6])/(z*z);val xy=(h[1]*z-a*h[7])/(z*z)
+    val yx=(h[3]*z-b*h[6])/(z*z);val yy=(h[4]*z-b*h[7])/(z*z)
+    val determinant=xx*yy-xy*yx
+    if(determinant==0.0 || !determinant.isFinite())return 0.0
+    val rho=max(hypot(yy,yx),hypot(xy,xx))/abs(determinant)
+    return if(rho.isFinite())log2(max(1.0,rho)).coerceIn(0.0,lastLevel.toDouble())else 0.0
+}
