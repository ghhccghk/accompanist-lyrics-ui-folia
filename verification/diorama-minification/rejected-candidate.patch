+// SPDX-License-Identifier: AGPL-3.0-only
+package top.ghhccghk.accompanist.lyrics.folia
+
+import androidx.compose.ui.geometry.*
+import androidx.compose.ui.graphics.*
+import androidx.compose.ui.graphics.drawscope.*
+import androidx.compose.ui.unit.*
+import top.ghhccghk.accompanist.lyrics.folia.internal.styles.diorama.*
+import kotlin.math.*
+
+/** Test-only explicit pyramid, not another filterQuality hint. All levels are
+ * prepared BEFORE drawing; LOD comes solely from the projective Jacobian.
+ * Isotropic center-footprint approximation is labelled, not source aniso4. */
+internal class DioramaExplicitMipControl(image:ImageBitmap) {
+    val levels:List<ImageBitmap> = buildList {
+        add(image)
+        while(last().width>1 || last().height>1) {
+            val previous=last();val width=max(1,previous.width/2);val height=max(1,previous.height/2)
+            val next=ImageBitmap(width,height)
+            CanvasDrawScope().draw(Density(1f),LayoutDirection.Ltr,Canvas(next),Size(width.toFloat(),height.toFloat())) {
+                drawImage(previous,dstSize=IntSize(width,height),filterQuality=FilterQuality.Low)
+            }
+            add(next)
+        }
+    }
+    var lastLod:Double=Double.NaN
+        private set
+
+    fun draw(scope:DrawScope,view:DioramaPerspective,origin:DioramaVec,x:DioramaVec,y:DioramaVec,
+        alpha:Float,color:Color,fog:DioramaFog) {
+        val base=levels.first();val h=view.planeHomography(origin,x,y)
+        val u=base.width/2.0;val v=base.height/2.0
+        val a=h[0]*u+h[1]*v+h[2];val b=h[3]*u+h[4]*v+h[5];val z=h[6]*u+h[7]*v+h[8]
+        val xx=(h[0]*z-a*h[6])/(z*z);val xy=(h[1]*z-a*h[7])/(z*z)
+        val yx=(h[3]*z-b*h[6])/(z*z);val yy=(h[4]*z-b*h[7])/(z*z)
+        val determinant=xx*yy-xy*yx
+        val rho=max(hypot(yy,yx),hypot(xy,xx))/abs(determinant)
+        val lod=log2(max(1.0,rho)).coerceAtMost(levels.lastIndex.toDouble());lastLod=lod
+        val low=floor(lod).toInt();val high=min(low+1,levels.lastIndex);val weight=(lod-low).toFloat()
+        val canvas=scope.drawContext.canvas
+        canvas.saveLayer(Rect(0f,0f,view.width.toFloat(),view.height.toFloat()),Paint())
+        try {
+            for((index,fraction)in listOf(low to 1f-weight,high to weight)) {
+                if(fraction<=0)continue
+                val image=levels[index]
+                with(scope){drawDioramaPlane(image,view,origin,x*(base.width.toDouble()/image.width),
+                    y*(base.height.toDouble()/image.height),alpha*fraction,color,additive=true,fog=fog)}
+            }
+        }finally{canvas.restore()}
+    }
+}
