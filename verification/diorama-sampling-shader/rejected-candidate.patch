+package top.ghhccghk.accompanist.lyrics.folia
+
+import androidx.compose.ui.geometry.Size
+import androidx.compose.ui.graphics.*
+import androidx.compose.ui.graphics.drawscope.DrawScope
+import org.jetbrains.skia.FilterMipmap
+import org.jetbrains.skia.FilterMode
+import org.jetbrains.skia.MipmapMode
+import top.ghhccghk.accompanist.lyrics.folia.internal.styles.diorama.DioramaTextureSampler
+import java.util.IdentityHashMap
+
+/** Diagnostic only. Public Skia Bitmap shader avoids Compose's strict srcRect
+ * image call. It still paints THROUGH Compose, preserving parent alpha/state.
+ * Identical no-mip control separates that drawing path from mipmap selection. */
+internal class DioramaMipmapSampler(private val mipmap:MipmapMode):DioramaTextureSampler,AutoCloseable {
+    private data class Resource(val shader:org.jetbrains.skia.Shader,val brush:ShaderBrush)
+    private val resources=IdentityHashMap<ImageBitmap,Resource>()
+    override fun draw(scope:DrawScope,image:ImageBitmap,alpha:Float,color:Color?,additive:Boolean) {
+        val resource=resources.getOrPut(image) {
+            val shader=image.asSkiaBitmap().makeShader(sampling=FilterMipmap(FilterMode.LINEAR,mipmap))
+            Resource(shader,ShaderBrush(shader.asComposeShader()))
+        }
+        with(scope) {
+            drawRect(resource.brush,size=Size(image.width.toFloat(),image.height.toFloat()),alpha=alpha,
+                colorFilter=color?.let{ColorFilter.tint(it)},blendMode=if(additive)BlendMode.Plus else BlendMode.SrcOver)
+        }
+    }
+    override fun close() {resources.values.forEach{it.shader.close()};resources.clear()}
+}
